# 운영 서버에서 이 파일을 .env로 복사해 값을 채운다. .env는 절대 커밋하지 말 것.
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=baton
DB_USER=baton
DB_PASSWORD=

BATON_JWT_SECRET=
# 근무 일괄 등록 미리보기 토큰 서명 키(32바이트 이상, JWT 키와 다른 값)
BATON_SHIFT_PREVIEW_SECRET=
BATON_GOOGLE_CLIENT_IDS=
BATON_APPLE_CLIENT_IDS=
BATON_CORS_ALLOWED_ORIGINS=

SWAGGER_ENABLED=true
